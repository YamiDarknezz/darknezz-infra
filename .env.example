# ============================================================
# darknezz-infra — plantilla de secrets
# Copia este archivo a .env y llena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# Cloudflare API Token (Edit zone DNS para darknezz.dev) - usado por Traefik dnsChallenge
CLOUDFLARE_TOKEN=

# Dominio base (los labels de Traefik lo interpolan: postgresql.${DOMAIN})
DOMAIN=darknezz.dev

# BasicAuth del dashboard Traefik: htpasswd -nb user pass  (o openssl passwd -apr1)
DASHBOARD_HASH=

# JWT signing (futuros servicios) (>= 32 chars, aleatorio)
JWT_SECRET=

# PostgreSQL (local)
POSTGRES_HOST=postgresql.darknezz.dev
POSTGRES_PORT=5432
POSTGRES_DB=darknezz
POSTGRES_USER=yamidarknezz
POSTGRES_PASSWORD=

# Let's Encrypt email
ACME_EMAIL=

# Prometheus — credenciales para scrapear https://traefik.${DOMAIN}/metrics
TRAEFIK_METRICS_USER=
TRAEFIK_METRICS_PASSWORD=

# Grafana — usuario admin inicial
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Telegram (alertas Alertmanager)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
