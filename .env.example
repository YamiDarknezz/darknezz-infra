# ============================================================
# darknezz-infra — plantilla de secrets
# Copia este archivo a .env y llena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# Cloudflare API Token (Edit zone DNS para example.dev) - usado por Traefik dnsChallenge
CLOUDFLARE_TOKEN=

# Dominio base (los labels de Traefik lo interpolan: api-inventory.${DOMAIN})
DOMAIN=example.dev

# BasicAuth del dashboard Traefik: htpasswd -nb user pass  (o openssl passwd -apr1)
DASHBOARD_HASH=

# inventory-api — firma de tokens JWT (>= 32 chars, aleatorio)
JWT_SECRET=

# inventory-api — PostgreSQL (Neon, connection string POOLED con sslmode=require)
# ej: postgresql://user:***@ep-xxx.pooler.us-east-1.aws.neon.tech/inventory?sslmode=require
DB_URL=
DB_USER=
DB_PASSWORD=

# Prometheus — credenciales para scrapear https://traefik.${DOMAIN}/metrics (mismas del dashboard)
TRAEFIK_METRICS_USER=
TRAEFIK_METRICS_PASSWORD=

# Grafana — usuario admin inicial (la primera vez; luego se gestiona en la UI)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
