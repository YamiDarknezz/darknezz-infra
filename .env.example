# ============================================================
# darknezz-infra — plantilla de secrets
# Copia este archivo a .env y llena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# Cloudflare API Token (Edit zone DNS) — usado por Traefik dnsChallenge
CLOUDFLARE_TOKEN=

# Dominio base (los labels de Traefik lo interpolan)
DOMAIN=darknezz.dev

# BasicAuth del dashboard Traefik: htpasswd -nb user pass
DASHBOARD_HASH=

# JWT signing (>= 32 chars, aleatorio)
JWT_SECRET=

# PostgreSQL
POSTGRES_HOST=postgresql.darknezz.dev
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Let's Encrypt email
ACME_EMAIL=

# Prometheus — credenciales para scrapear metrics
TRAEFIK_METRICS_USER=
TRAEFIK_METRICS_PASSWORD=

# Grafana — usuario admin inicial
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Telegram (alertas Alertmanager)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# File Browser
FILEBROWSER_USER=admin
FILEBROWSER_PASSWORD=

# Security alerts (SSH fingerprints e IPs autorizadas)
# OJO: los valores con VARIOS elementos van entre comillas. Sin comillas, `source .env`
# intenta ejecutar el segundo elemento como comando: la variable queda VACÍA y el error
# se pierde entre la salida del script (allowlist a ciegas, en silencio).
ALLOWED_KEYS="fp1 fp2"
ALLOWED_IPS="1.2.3.4 5.6.7.8"
# IP publica del propio VPS (la inyecta setup-fail2ban.sh en ignoreip)
VPS_PUBLIC_IP=
